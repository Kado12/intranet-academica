generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCENTE
  ESTUDIANTE
  PADRE_DE_FAMILIA
  COORDINADOR
  INFORMATICO
  SECRETARIA
}

enum PeriodStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  TRANSFERRED
  COMPLETED
}

enum ParentRelationType {
  PADRE
  MADRE
  TUTOR
  OTRO
}

model Sede {
  id            String         @id @default(cuid())
  name          String
  address       String?
  phone         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  classrooms    Classroom[]
  memberships   Membership[]
  announcements Announcement[]

  // ← NUEVO
  paymentPlans PaymentPlan[]

  @@map("sedes")
}

model AcademicPeriod {
  id        String       @id @default(cuid())
  name      String       @unique
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sections  Section[]

  @@map("academic_periods")
}

model Turn {
  id        String    @id @default(cuid())
  name      String    @unique
  startTime String?
  endTime   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sections  Section[]

  @@map("turns")
}

model Classroom {
  id        String    @id @default(cuid())
  name      String
  location  String?
  capacity  Int?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sedeId    String
  sede      Sede      @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  sections  Section[]

  @@index([sedeId])
  @@map("classrooms")
}

model Section {
  id             String          @id @default(cuid())
  name           String
  capacity       Int?
  priority       Int             @default(1) // ← NUEVO: Prioridad de llenado (1 = primero)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  classroomId    String
  turnId         String
  periodId       String
  classroom      Classroom       @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  turn           Turn            @relation(fields: [turnId], references: [id], onDelete: Restrict)
  period         AcademicPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  enrollments    Enrollment[]
  sectionCourses SectionCourse[]
  announcements  Announcement[]

  @@unique([classroomId, turnId, periodId, name])
  @@index([classroomId])
  @@index([turnId])
  @@index([periodId])
  @@index([priority]) // ← NUEVO: Índice para búsquedas por prioridad
  @@map("sections")
}

model Course {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  courseTeachers CourseTeacher[]
  sectionCourses SectionCourse[]

  @@map("courses")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  isActive           Boolean            @default(true)
  mustChangePassword Boolean            @default(false) // ← NUEVO
  passwordChangedAt  DateTime? // ← NUEVO
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profile            Profile?
  memberships        Membership[]
  courseTeachers     CourseTeacher[]
  sectionCourses     SectionCourse[]
  enrollments        Enrollment[]
  parentOf           ParentStudent[]    @relation("Parent")
  studentOf          ParentStudent[]    @relation("Student")
  studentAttendances Attendance[]       @relation("StudentAttendance")
  excusedAttendances Attendance[]       @relation("ExcusedAttendance")
  studentGrades      Grade[]            @relation("StudentGrades")
  gradedGrades       Grade[]            @relation("GradedBy")
  createdTasks       Task[]             @relation("TaskCreatedBy")
  studentSubmissions TaskSubmission[]   @relation("StudentSubmissions")
  gradedSubmissions  TaskSubmission[]   @relation("SubmissionGradedBy")
  announcements      Announcement[]     @relation("AnnouncementAuthor")
  announcementViews  AnnouncementView[] @relation("AnnouncementViews")
  auditLogs          AuditLog[]
  registeredPayments PaymentRecord[]    @relation("PaymentRegisteredBy")

  @@map("users")
}

model Profile {
  id             String    @id @default(cuid())
  userId         String    @unique
  firstName      String
  lastName       String
  documentType   String?
  documentNumber String?   @unique // DNI único en todo el sistema
  phone          String?
  birthDate      DateTime? @db.Date
  gender         String? // ← NUEVO: M, F, Otro
  address        String? // ← NUEVO: Dirección
  avatarUrl      String? // ← NUEVO: URL pública de Cloudinary
  avatarPublicId String? // ← NUEVO: ID en Cloudinary para gestionar
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentNumber])
  @@map("profiles")
}

model Membership {
  id        String           @id @default(cuid())
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String
  // Si sedeId es null, el rol se considera global.
  sedeId    String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sede      Sede?            @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  @@unique([userId, role, sedeId])
  @@index([userId])
  @@index([sedeId])
  @@map("memberships")
}

model CourseTeacher {
  id        String   @id @default(cuid())
  courseId  String
  teacherId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([courseId])
  @@index([teacherId])
  @@map("course_teachers")
}

model SectionCourse {
  id        String   @id @default(cuid())
  sectionId String
  courseId  String
  teacherId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  // Nuevas relaciones
  attendances Attendance[]
  assessments Assessment[]
  tasks       Task[]

  @@unique([sectionId, courseId])
  @@index([sectionId])
  @@index([courseId])
  @@index([teacherId])
  @@map("section_courses")
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  sectionId      String
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  student        User             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  paymentPlanId  String?
  paymentPlan    PaymentPlan?     @relation(fields: [paymentPlanId], references: [id])
  paymentRecords PaymentRecord[]

  @@unique([studentId, sectionId])
  @@index([studentId])
  @@index([sectionId])
  @@index([paymentPlanId])
  @@map("enrollments")
}

model ParentStudent {
  id           String             @id @default(cuid())
  parentId     String
  studentId    String
  relationType ParentRelationType @default(OTRO)
  isPrimary    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  parent       User               @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  student      User               @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

// ==================== ASISTENCIA ====================

enum AttendanceStatus {
  PRESENT // Presente
  ABSENT // Ausente
  LATE // Tarde
  EXCUSED // Justificado
}

model Attendance {
  id              String           @id @default(cuid())
  date            DateTime         @db.Date
  status          AttendanceStatus
  notes           String?
  studentId       String
  sectionCourseId String
  student         User             @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  sectionCourse   SectionCourse    @relation(fields: [sectionCourseId], references: [id], onDelete: Cascade)
  excusedBy       User?            @relation("ExcusedAttendance", fields: [excusedById], references: [id])
  excusedById     String?
  excuseNote      String?
  excuseDate      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([studentId, sectionCourseId, date]) // Una asistencia por estudiante por curso por día
  @@index([sectionCourseId, date])
  @@index([studentId])
  @@map("attendances")
}

// ==================== CALIFICACIONES ====================

enum AssessmentType {
  EXAM // Examen
  QUIZ // Prueba rápida
  HOMEWORK // Tarea
  PROJECT // Proyecto
  PARTICIPATION // Participación
  OTHER // Otro
}

model Assessment {
  id              String         @id @default(cuid())
  name            String
  type            AssessmentType
  maxScore        Float          @default(20) // Nota máxima (por defecto 20, sistema peruano)
  weight          Float          @default(1) // Peso para el promedio ponderado
  date            DateTime       @db.Date
  sectionCourseId String
  sectionCourse   SectionCourse  @relation(fields: [sectionCourseId], references: [id], onDelete: Cascade)
  grades          Grade[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([sectionCourseId])
  @@map("assessments")
}

model Grade {
  id           String     @id @default(cuid())
  score        Float
  comment      String?
  studentId    String
  assessmentId String
  student      User       @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  gradedBy     User?      @relation("GradedBy", fields: [gradedById], references: [id])
  gradedById   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, assessmentId]) // Una nota por estudiante por evaluación
  @@index([assessmentId])
  @@index([studentId])
  @@map("grades")
}

// ==================== TAREAS ====================

enum TaskStatus {
  PENDING // Pendiente
  SUBMITTED // Entregada
  GRADED // Calificada
  LATE // Entregada tarde
  MISSING // No entregada
}

model Task {
  id              String           @id @default(cuid())
  title           String
  description     String?
  dueDate         DateTime
  maxScore        Float            @default(20)
  sectionCourseId String
  sectionCourse   SectionCourse    @relation(fields: [sectionCourseId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById     String
  submissions     TaskSubmission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([sectionCourseId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskSubmission {
  id          String     @id @default(cuid())
  content     String?
  fileUrl     String?
  submittedAt DateTime   @default(now())
  status      TaskStatus @default(PENDING)
  score       Float?
  feedback    String?
  studentId   String
  taskId      String
  student     User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  gradedBy    User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id])
  gradedById  String?
  gradedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([studentId, taskId]) // Una entrega por estudiante por tarea
  @@index([taskId])
  @@index([studentId])
  @@map("task_submissions")
}

// ==================== ANUNCIOS ====================

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  content   String
  priority  AnnouncementPriority @default(MEDIUM)
  publishAt DateTime             @default(now())
  expiresAt DateTime?
  authorId  String
  author    User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  sedeId    String?
  sede      Sede?                @relation(fields: [sedeId], references: [id])
  sectionId String?
  section   Section?             @relation(fields: [sectionId], references: [id])
  isGlobal  Boolean              @default(false) // Si es para toda la institución
  views     AnnouncementView[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([sedeId])
  @@index([sectionId])
  @@index([publishAt])
  @@map("announcements")
}

model AnnouncementView {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation("AnnouncementViews", fields: [userId], references: [id], onDelete: Cascade)
  viewedAt       DateTime     @default(now())

  @@unique([announcementId, userId]) // Un usuario ve un anuncio una vez
  @@index([userId])
  @@map("announcement_views")
}

// ==================== PLANES DE PAGO ====================

enum PaymentPlanType {
  FULL_PAYMENT // Pago completo del ciclo
  INSTALLMENTS // Pago en cuotas
  SIBLING_DISCOUNT // Descuento por hermanos
  AGREEMENT // Convenio institucional
  SCHOLARSHIP // Beca
  OTHER // Otro
}

model PaymentPlan {
  id           String          @id @default(cuid())
  name         String // "Plan Hermanos", "Convenio Empresa X", "Pago Completo"
  type         PaymentPlanType
  description  String?
  baseAmount   Float // Monto base de la matrícula
  discount     Float           @default(0) // Porcentaje de descuento (0-100)
  finalAmount  Float // Monto final después del descuento
  installments Int? // Número de cuotas (si aplica)
  isActive     Boolean         @default(true)
  sedeId       String? // Puede ser específico de una sede o global
  sede         Sede?           @relation(fields: [sedeId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  enrollments  Enrollment[]

  @@index([sedeId])
  @@index([type])
  @@map("payment_plans")
}

// ==================== AUDITORÍA ====================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  TRANSFER
  RESET_PASSWORD
  LOGIN
  LOGOUT
  UPLOAD_PHOTO
  DOWNLOAD_PDF
}

enum AuditEntity {
  USER
  PROFILE
  ENROLLMENT
  SECTION
  CLASSROOM
  SEDE
  PAYMENT_PLAN
  PERIOD
  COURSE
}

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  entity        AuditEntity
  entityId      String? // ID de la entidad afectada
  entityName    String? // Nombre descriptivo (ej: email del usuario)
  oldData       Json? // Datos anteriores (antes del cambio)
  newData       Json? // Datos nuevos (después del cambio)
  changedFields Json? // Lista de campos que cambiaron
  userId        String? // Usuario que realizó la acción
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== SEGUIMIENTO DE PAGOS ====================

enum PaymentStatus {
  PENDING // Pendiente de pago
  PAID // Pagado
  OVERDUE // Vencido
  WAIVED // Condonado/exonerado
}

model PaymentRecord {
  id                String        @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount            Float
  installmentNumber Int? // Número de cuota (1, 2, 3...). Null si es pago único
  totalInstallments Int? // Total de cuotas del plan
  status            PaymentStatus @default(PENDING)
  dueDate           DateTime
  paidAt            DateTime?
  paymentMethod     String? // Efectivo, transferencia, tarjeta, etc.
  reference         String? // Número de referencia o voucher
  notes             String?
  registeredById    String?
  registeredBy      User?         @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([enrollmentId])
  @@index([status])
  @@index([dueDate])
  @@map("payment_records")
}
