{
  "name": "intranet-academica",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:generate": "pnpm --filter @intranet/database run prisma:generate",
    "db:migrate": "pnpm --filter @intranet/database run prisma:migrate",
    "db:studio": "pnpm --filter @intranet/database run prisma:studio",
    "api:dev": "pnpm --filter api run dev",
    "api:build": "pnpm --filter api run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}