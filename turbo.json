{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": [
      "^build"
    ],
    "outputs": [
      "dist/**",
      "build/**"
    ]
  },
  "dev": {
    "cache": false,
    "persistent": true
  },
  "lint": {
    "dependsOn": [
      "^lint"
    ]
  },
  "typecheck": {
    "dependsOn": [
      "^typecheck"
    ]
  }
}